# Copy to .env.local and enter values from Supabase > Project Settings > API.
# Use a public publishable key (sb_publishable_...) or a legacy anon key.
# NEVER place a secret/service_role key in Vite env; browser variables are public.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
